params {
    genome_index = "/mnt/scratch/a_blinova/ncbi_dataset/data/GCF_000001405.40"
    samplesheet = "samplesheet.csv"
}
//смысл прописывать cpu только если команда об этом знает
process {
    executor = 'slurm'
    queue = 'intbio'
    clusterOptions = '--output=/mnt/scratch/a_blinova/pype2/logs/slurm-%j.out --error=/mnt/scratch/a_blinova/pype2/logs/slurm-%j.err'

    withName: FASTQC {
        cpus = 1
        memory = '30 GB'
    }

    withName: ALIGN {
        cpus = 6
        memory = '200 GB'
        time = '100h'
    }

    withName: DeDUPLICATE {
        cpus = 2
        memory = '8 GB'
        time = '100h'
    }

    withName: METH_CALL {
        memory = '50 GB'
    }
}

